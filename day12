function chunkArray(arr, size) {
  const chunked = [];

  for (let i = 0; i < arr.length; i += size) {
    const chunk = arr.slice(i, i + size);
    chunked.push(chunk);
  }

  return chunked;
}

// Example usage:
console.log(chunkArray([1, 2, 3, 4, 5, 6, 7, 8], 3));
// Output: [[1, 2, 3], [4, 5, 6], [7, 8]]

console.log(chunkArray(['a', 'b', 'c', 'd'], 2));
// Output: [['a', 'b'], ['c', 'd']]
