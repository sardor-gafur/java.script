import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        while (true) {

            System.out.println("\n==============================");
            System.out.println("       JAVA KALKULYATOR");
            System.out.println("==============================");
            System.out.println("1. Qo‘shish");
            System.out.println("2. Ayirish");
            System.out.println("3. Ko‘paytirish");
            System.out.println("4. Bo‘lish");
            System.out.println("5. Darajaga oshirish");
            System.out.println("6. Qoldiqni topish");
            System.out.println("0. Chiqish");
            System.out.println("==============================");

            System.out.print("Tanlang: ");
            int tanlov = scanner.nextInt();

            if (tanlov == 0) {
                System.out.println("Dastur tugadi. Xayr!");
                break;
            }

            if (tanlov < 1 || tanlov > 6) {
                System.out.println("Noto‘g‘ri tanlov!");
                continue;
            }

            System.out.print("Birinchi sonni kiriting: ");
            double a = scanner.nextDouble();

            System.out.print("Ikkinchi sonni kiriting: ");
            double b = scanner.nextDouble();

            double natija;

            switch (tanlov) {

                case 1:
                    natija = a + b;
                    System.out.println("Natija: " + natija);
                    break;

                case 2:
                    natija = a - b;
                    System.out.println("Natija: " + natija);
                    break;

                case 3:
                    natija = a * b;
                    System.out.println("Natija: " + natija);
                    break;

                case 4:
                    if (b == 0) {
                        System.out.println("0 ga bo‘lish mumkin emas!");
                    } else {
                        natija = a / b;
                        System.out.println("Natija: " + natija);
                    }
                    break;

                case 5:
                    natija = Math.pow(a, b);
                    System.out.println("Natija: " + natija);
                    break;

                case 6:
                    if (b == 0) {
                        System.out.println("0 ga qoldiq olish mumkin emas!");
                    } else {
                        natija = a % b;
                        System.out.println("Natija: " + natija);
                    }
                    break;
            }
        }

        scanner.close();
    }
}
